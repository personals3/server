# =============================================================================
# PersonalS3 - Environment Configuration
# Copy this file to .env and adjust values for your setup
# =============================================================================

# ---- PostgreSQL ----
POSTGRES_USER=s3admin
POSTGRES_PASSWORD=CHANGE_ME_use_openssl_rand_-base64_32
POSTGRES_DB=personals3
POSTGRES_PORT=5432

# ---- Initial admin user (only used on FIRST startup with a fresh DB) ----
# If EITHER is blank, the seed is skipped — no default admin is created and
# you'll need to insert one manually. Set them to bootstrap a fresh install.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# ---- Valkey (Redis-compatible) ----
VALKEY_PORT=6379
VALKEY_PASSWORD=CHANGE_ME_use_openssl_rand_-base64_32

# ---- API Server (Go) ----
API_PORT=3000
API_HOST=0.0.0.0

# UID/GID the container runs as. MUST match the host owner of STORAGE_ROOT
# so the container can write into the bind-mounted directory.
# Get yours with:  id -u   and   id -g
UID=1000
GID=1000

# Connection strings (used by API + worker) — these expand from the values above.
DATABASE_URL=postgres://s3admin:${POSTGRES_PASSWORD}@postgres:5432/personals3?sslmode=disable
VALKEY_URL=redis://:${VALKEY_PASSWORD}@valkey:6379/0

# JWT secret for session tokens (generate with: openssl rand -hex 64)
JWT_SECRET=CHANGE_ME_use_openssl_rand_-hex_64

# ---- Dashboard (Next.js) ----
DASHBOARD_PORT=3001
# Same-origin nginx routing (recommended). Browser → /api → nginx → api container.
# Port 3000 is internal-only in compose; using it directly here causes
# ERR_CONNECTION_REFUSED on browsers reaching the page.
NEXT_PUBLIC_API_URL=/api

# Footer attribution shown on the public landing page. If OPERATOR_URL is
# blank, the footer renders just the name without a link. Re-build the
# dashboard image after changing these (Next.js bakes NEXT_PUBLIC_* at
# build time, not runtime).
NEXT_PUBLIC_OPERATOR_NAME=this instance's administrator
NEXT_PUBLIC_OPERATOR_URL=

# User-docs site used by the dashboard's contextual "learn more" links
# (new-tab). Self-hosters can point this at their own docs.
NEXT_PUBLIC_DOCS_URL=https://developers.personals3.tech

# ---- Storage ----
# Root directory for object data (mounted into containers)
# Make sure this path has enough space (you mentioned ~1TB)
STORAGE_ROOT=./storage

# Default quota for new users in bytes (100 MB — admin can override per
# approval, and the quota-request flow is the path to more space).
DEFAULT_QUOTA_BYTES=104857600

# ---- Email (SMTP) ------------------------------------------------------
# Leave blank to use the dev outbox at storage/.email-outbox/.
#
# Gmail (recommended for personal use):
#   1. Turn on 2FA on the Google account.
#   2. Create an App password at https://myaccount.google.com/apppasswords
#   3. Fill in:
#        SMTP_HOST=smtp.gmail.com
#        SMTP_PORT=587
#        SMTP_USER=youraddress@gmail.com
#        SMTP_PASS=<16-char app password, no spaces>
#        SMTP_TLS=1
#
# AWS SES:    SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# Postmark:   SMTP_HOST=smtp.postmarkapp.com  (SMTP_USER=SMTP_PASS=server token)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@your-domain.example
SMTP_FROM_NAME=PersonalS3
# Reply-To header — where replies to outbound mail land. Pair with a
# Cloudflare Email Routing rule that forwards this address to your inbox.
SMTP_REPLY_TO=support@your-domain.example
SMTP_TLS=1

# The base URL strangers see in outbound mail (sign-in link, etc).
# Set to your tunnel/proxy URL once it's live, e.g. https://personals3.tech
PUBLIC_BASE_URL=http://localhost:8080

# Address that gets the "new account / quota request" admin notifications.
# Leave blank to reuse ADMIN_EMAIL.
# ADMIN_EMAIL is already defined above; this section just documents the
# additional roles it plays for the new self-serve flows.

# Multipart upload chunk size in bytes (5 MB)
MULTIPART_CHUNK_SIZE=5242880

# ---- Nginx ----
# Default 8080 to avoid clashing with system services on port 80.
# When you set up Cloudflare Tunnel in Part 9, the tunnel forwards to whatever
# port nginx binds here, so any value works.
NGINX_HTTP_PORT=8080

# ---- Domains (used by Cloudflare Tunnel later) ----
# Leave as localhost during local dev
API_DOMAIN=localhost
DASHBOARD_DOMAIN=localhost
SEGMENTS_DOMAIN=localhost

# ---- Worker (Python) ----
WORKER_POLL_INTERVAL=2
WORKER_CONCURRENCY=2

# Hardware video encoding via VA-API (Intel iGPU / AMD APU).
# Requires /dev/dri on the host. Set to 0 to force CPU encoding.
USE_GPU=1
# Cap each ffmpeg's thread pool — avoids thread contention when many
# workers run in parallel.
FFMPEG_THREADS=4
# Host group IDs that own /dev/dri (run: getent group video render).
# 44 (video) is Debian/Ubuntu standard. 993 (render) is common on newer kernels.
VIDEO_GID=44
RENDER_GID=993

# ---- Cloudflare Tunnel (Part 9) ----
# Only needed if you use the named-tunnel profile:
#   docker compose --profile tunnel up -d cloudflared
# Get a token from dash.cloudflare.com → Zero Trust → Networks → Tunnels.
# Leave empty if you only use the quick tunnel (random URL, no domain).
CLOUDFLARED_TOKEN=
