# Caddy config — same routing as nginx/nginx.conf but with automatic HTTPS.
#
# Set CADDY_DOMAIN in .env to your real domain. Caddy provisions a Let's
# Encrypt cert automatically on first start (needs port 80 + 443 reachable
# from the public internet for the HTTP-01 challenge).
#
# For local-only testing, set CADDY_DOMAIN=localhost — Caddy uses its own
# internal CA (browser will show "not secure" because the cert isn't from
# a public CA, but it works).
#
# To switch from nginx to Caddy:
#   1. Stop nginx:    docker compose stop nginx
#   2. Set domain:    echo 'CADDY_DOMAIN=storage.example.com' >> .env
#   3. Start Caddy:   docker compose --profile caddy up -d caddy
#
# To revert: docker compose stop caddy && docker compose up -d nginx

{
	# Global options
	# Disable the admin API on its default port (we don't use it)
	admin off
	# Email for Let's Encrypt — required for cert renewal notifications
	email {$ADMIN_EMAIL:admin@local}
}

{$CADDY_DOMAIN:localhost} {
	# Logs to stdout — surfaces in `docker logs s3-caddy`
	log {
		output stdout
		format json
	}

	# Generous upload limit. Multipart Complete sends the parts list which
	# is small; individual parts go via PUT /:bucket/* and stream through.
	request_body {
		max_size 0
	}

	# Per-extension cache hints for HLS / image content
	@hls path *.m3u8 *.ts
	header @hls {
		Cache-Control "public, max-age=300"
	}
	@images path *.webp *.avif *.jpg *.jpeg *.png *.gif
	header @images {
		Cache-Control "public, max-age=31536000, immutable"
	}

	# Health check
	respond /caddy-health 200 {
		body "ok"
	}

	# /stream/* — static HLS / image / segment serving (Caddy's built-in
	# file_server is plenty fast; sendfile equivalent.)
	handle_path /stream/* {
		root * /storage/segments
		file_server {
			precompressed gzip
		}
	}

	# /api/* — Go API. Strip the /api prefix.
	handle_path /api/* {
		reverse_proxy api:3000 {
			# Forward original host + scheme for SigV4
			header_up X-Original-URI {uri}
			header_up Host {host}
			header_up X-Forwarded-Proto https
		}
	}

	# Force /api to redirect to /api/ so SDK clients hit a route that exists
	redir /api /api/ permanent

	# /share/* — public download for presigned URLs
	handle /share/* {
		reverse_proxy api:3000
		header Access-Control-Allow-Origin "*"
	}

	# /public/* — anonymous read for public buckets
	handle /public/* {
		reverse_proxy api:3000
		header Access-Control-Allow-Origin "*"
	}

	# Everything else → Next.js dashboard
	handle {
		reverse_proxy dashboard:3001 {
			# Forward upgrade headers for HMR / WebSocket in dev
			header_up Connection {>Connection}
			header_up Upgrade {>Upgrade}
		}
	}
}
